{
  "name": "yodla",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:server": "npm run dev --prefix server",
    "start": "node server/src/index.js",
    "build:srs": "esbuild src/lib/srs.ts --format=esm --target=node20 --outfile=server/src/srs.gen.js"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "type": "module",
  "private": true
}
