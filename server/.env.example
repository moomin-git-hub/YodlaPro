# Neon Postgres (Dashboard → Connect → pooled connection string)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Neon Object Storage (Project → branch → Object storage tab → create bucket + credential)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
STORAGE_BUCKET=yodla
# AI (optional): anthropic | openai | gemini | openrouter
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Public app URL (for password-reset links) and optional SMTP
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Only needed if the frontend is hosted elsewhere (comma-separated origins)
CORS_ORIGINS=
PORT=3000
